NODE_ENV=development
PORT=3000
APP_NAME=Loghme
APP_TIMEZONE=Asia/Tehran

# ============================================================
# CLOUD POSTGRESQL (Supabase / Neon)
# ============================================================
# از پنل Supabase → Settings → Database → Connection string
# حالت Session pooler رو انتخاب کن (port 5432) برای DATABASE_URL
# حالت Direct connection رو انتخاب کن برای DIRECT_URL
#
# نمونه Supabase:
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require&pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"
#
# نمونه Neon:
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ============================================================
# REDIS — اختیاری
# ============================================================
# اگر خالی بگذاری، از in-memory استفاده می‌شود.
# برای Upstash: rediss://default:PASSWORD@xxx.upstash.io:6379
REDIS_URL=""

# ============================================================
# JWT
# ============================================================
JWT_ACCESS_SECRET=loghme_dev_access_secret_change_me_2024_min32chars
JWT_REFRESH_SECRET=loghme_dev_refresh_secret_change_me_2024_min32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ============================================================
# OTP
# ============================================================
OTP_LENGTH=6
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60

# ============================================================
# SMS (اختیاری — فعلاً mock)
# ============================================================
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=10008663

# ============================================================
# PAYMENT (اختیاری — فعلاً mock)
# ============================================================
SHAPARAK_MERCHANT_ID=
SAMAN_KISH_TERMINAL_ID=
SAMAN_KISH_TERMINAL_PASSWORD=

# ============================================================
# STORAGE (اختیاری)
# ============================================================
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=loghme-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# ============================================================
# MAP
# ============================================================
MAP_DEFAULT_CENTER_LAT=35.7860
MAP_DEFAULT_CENTER_LON=51.3740
MAP_DEFAULT_ZOOM=14
DELIVERY_MAX_RADIUS_KM=15

# ============================================================
# BUSINESS
# ============================================================
COURIER_BASE_FEE=15000
COURIER_PER_KM_FEE=3500
PLATFORM_COMMISSION_PERCENT=12
PRO_MONTHLY_FEE=189000
WALLET_MIN_TOPUP=10000
WALLET_MAX_TOPUP=50000000

# ============================================================
# CORS
# ============================================================
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:5173

LOG_LEVEL=debug