NODE_ENV=development
PORT=3000
APP_NAME=Loghme
APP_TIMEZONE=Asia/Tehran

# ============================================================
# AI CHATBOT (LOGHME-YAR) — OWNER MANAGED ON SERVER ONLY
# ============================================================
GEMINI_API_KEY=YOUR_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite

# ============================================================
# CLOUD POSTGRESQL (Supabase / Neon)
# ============================================================
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ============================================================
# REDIS (Optional)
# ============================================================
REDIS_URL=""

# ============================================================
# JWT
# ============================================================
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ============================================================
# OTP
# ============================================================
OTP_LENGTH=6
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60

# ============================================================
# SMS (Optional)
# ============================================================
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=10008663

# ============================================================
# PAYMENT (Optional)
# ============================================================
SHAPARAK_MERCHANT_ID=
SAMAN_KISH_TERMINAL_ID=
SAMAN_KISH_TERMINAL_PASSWORD=

# ============================================================
# STORAGE (Optional)
# ============================================================
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=loghme-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# ============================================================
# MAP
# ============================================================
MAP_DEFAULT_CENTER_LAT=35.7860
MAP_DEFAULT_CENTER_LON=51.3740
MAP_DEFAULT_ZOOM=14
DELIVERY_MAX_RADIUS_KM=15

# ============================================================
# BUSINESS
# ============================================================
COURIER_BASE_FEE=15000
COURIER_PER_KM_FEE=3500
PLATFORM_COMMISSION_PERCENT=12
PRO_MONTHLY_FEE=189000
WALLET_MIN_TOPUP=10000
WALLET_MAX_TOPUP=50000000

# ============================================================
# CORS
# ============================================================
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:5173

LOG_LEVEL=debug