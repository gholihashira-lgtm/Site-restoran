generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DATABASE_URL_UNPOOLED")
  extensions = [postgis, pgcrypto, pg_trgm, btree_gist, unaccent]
}

// ============================================================
// USERS & AUTH
// ============================================================

model User {
  id              String   @id @default(uuid()) @db.Uuid
  phone           String   @unique
  fullName        String?
  email           String?  @unique
  role            UserRole @default(CUSTOMER)
  birthDay        String?
  birthMonth      String?
  birthYear       String?
  isPhoneVerified Boolean  @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  wallet        Wallet?
  membership    Membership?
  sessions      UserSession[]
  addresses     Address[]
  orders        Order[]
  ratings       OrderRating[]
  notifications Notification[]
  courier       Courier?

  @@map("users")
}

enum UserRole {
  CUSTOMER
  VENDOR_OWNER
  COURIER
  ADMIN
}

model UserSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  refreshToken String    @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  isRevoked    Boolean   @default(false)
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

// ============================================================
// WALLET
// ============================================================

model Wallet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  balance   BigInt   @default(0)
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id           String       @id @default(uuid()) @db.Uuid
  walletId     String       @db.Uuid
  orderId      String?      @db.Uuid
  type         WalletTxType
  amount       BigInt
  balanceAfter BigInt
  description  String?
  createdAt    DateTime     @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

enum WalletTxType {
  TOPUP
  ORDER_PAYMENT
  REFUND
  BONUS
  WITHDRAWAL
}

// ============================================================
// MEMBERSHIP (LOGHME PRO)
// ============================================================

model Membership {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  tier         ProTier  @default(FREE)
  proAutoRenew Boolean  @default(false)
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("memberships")
}

enum ProTier {
  FREE
  PRO
}

// ============================================================
// VENDORS
// ============================================================

model Vendor {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  type            String?
  slug            String?      @unique
  description     String?
  logoUrl         String?
  bannerUrl       String?
  status          VendorStatus @default(ACTIVE)
  isFeatured      Boolean      @default(false)
  rating          Float        @default(0)
  reviews         Int          @default(0)
  deliveryFee     BigInt       @default(0)
  deliveryTimeMin Int          @default(30)
  deliveryTimeMax Int          @default(45)
  latitude        Float?
  longitude       Float?
  location        Unsupported("geography(Point, 4326)")?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  categories   VendorCategory[]
  workingHours WorkingHours[]
  products     Product[]
  orders       Order[]

  @@index([status, isFeatured])
  @@map("vendors")
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

model VendorCategory {
  id        String   @id @default(uuid()) @db.Uuid
  vendorId  String   @db.Uuid
  title     String
  slug      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  vendor   Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([vendorId, sortOrder])
  @@map("vendor_categories")
}

model WorkingHours {
  id        String @id @default(uuid()) @db.Uuid
  vendorId  String @db.Uuid
  dayOfWeek Int
  openTime  String
  closeTime String

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("working_hours")
}

// ============================================================
// PRODUCTS
// ============================================================

model Product {
  id            Int      @id @default(autoincrement())
  vendorId      String   @db.Uuid
  categoryId    String?  @db.Uuid
  title         String
  description   String?
  imageUrl      String?
  price         BigInt
  originalPrice BigInt?
  discountPct   Int      @default(0)
  stockLeft     Int      @default(0)
  rating        Float    @default(0)
  reviews       Int      @default(0)
  isActive      Boolean  @default(true)
  subtype       String?
  calories      Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vendor     Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category   VendorCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  threeDMeta ThreeDMeta?
  addons     ProductAddon[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([vendorId, isActive])
  @@index([categoryId])
  @@map("products")
}

model ThreeDMeta {
  id        String  @id @default(uuid()) @db.Uuid
  productId Int     @unique
  modelUrl  String?
  metaJson  Json?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("three_d_meta")
}

model ProductAddon {
  id        String @id @default(uuid()) @db.Uuid
  productId Int
  title     String
  price     BigInt
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_addons")
}

// ============================================================
// CART
// ============================================================

model Cart {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  vendorId   String?  @db.Uuid
  couponCode String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id         String @id @default(uuid()) @db.Uuid
  cartId     String @db.Uuid
  productId  Int
  quantity   Int    @default(1)
  unitPrice  BigInt
  addonsJson Json?

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@map("cart_items")
}

// ============================================================
// COUPONS
// ============================================================

model Coupon {
  id            String     @id @default(uuid()) @db.Uuid
  code          String     @unique
  title         String?
  type          CouponType
  value         Decimal    @db.Decimal(12, 2)
  minOrderValue BigInt     @default(0)
  maxDiscount   BigInt?
  isActive      Boolean    @default(true)
  expiresAt     DateTime
  createdAt     DateTime   @default(now())

  @@map("coupons")
}

enum CouponType {
  PERCENT
  FIXED
}

// ============================================================
// ORDERS
// ============================================================

model Order {
  id                 String        @id @default(uuid()) @db.Uuid
  trackingCode       String        @unique
  userId             String        @db.Uuid
  vendorId           String        @db.Uuid
  addressId          String        @db.Uuid
  addressSnapshot    Json?
  status             OrderStatus   @default(PENDING_PAYMENT)
  deliveryMode       DeliveryMode  @default(COURIER)
  paymentMethod      PaymentMethod @default(WALLET)
  itemsSubtotal      BigInt
  deliveryFee        BigInt        @default(0)
  discountAmount     BigInt        @default(0)
  couponCode         String?
  grandTotal         BigInt
  etaMinutes         Int           @default(40)
  note               String?
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user          User                 @relation(fields: [userId], references: [id])
  vendor        Vendor               @relation(fields: [vendorId], references: [id])
  address       Address              @relation(fields: [addressId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  rating        OrderRating?
  courierAssign CourierAssignment?
  walletTx      WalletTransaction[]

  @@index([userId, createdAt])
  @@index([vendorId])
  @@map("orders")
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PREPARING
  READY
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum DeliveryMode {
  COURIER
  PICKUP
}

enum PaymentMethod {
  WALLET
  CARD
  CASH_ON_DELIVERY
}

model OrderItem {
  id            String @id @default(uuid()) @db.Uuid
  orderId       String @db.Uuid
  productId     Int
  titleSnapshot String
  priceSnapshot BigInt
  quantity      Int
  addonsJson    Json?
  lineTotal     BigInt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @db.Uuid
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model OrderRating {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @unique @db.Uuid
  userId        String   @db.Uuid
  foodRating    Int
  courierRating Int?
  comment       String?
  tags          String[] @default([])
  createdAt     DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@map("order_ratings")
}

// ============================================================
// ADDRESSES
// ============================================================

model Address {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String     @db.Uuid
  province      String
  city          String
  text          String
  pelak         String?
  unit          String?
  postalCode    String?
  receiverName  String
  receiverPhone String
  tag           AddressTag @default(HOME)
  icon          String?
  isDefault     Boolean    @default(false)
  isActive      Boolean    @default(true)
  latitude      Float?
  longitude     Float?
  location      Unsupported("geography(Point, 4326)")?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId, isActive])
  @@map("addresses")
}

enum AddressTag {
  HOME
  WORK
  OTHER
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType @default(SYSTEM)
  title     String
  body      String
  icon      String?
  color     String?
  action    Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

enum NotificationType {
  ORDER
  PROMO
  SUPPORT
  WALLET
  SYSTEM
}

// ============================================================
// STORIES
// ============================================================

model Story {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  thumbnail String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  slides StorySlide[]

  @@map("stories")
}

model StorySlide {
  id        String  @id @default(uuid()) @db.Uuid
  storyId   String  @db.Uuid
  type      String  @default("promo")
  media     String?
  headline  String?
  subtitle  String?
  sticker   Json?
  cta       Json?
  sortOrder Int     @default(0)

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId, sortOrder])
  @@map("story_slides")
}

// ============================================================
// SERVICE CATEGORIES & BANNERS
// ============================================================

model ServiceCategory {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  icon      String?
  color     String?
  badge     String?
  slug      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("service_categories")
}

model PromoBanner {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  subtitle  String?
  cta       String?
  bg        String?
  icon      String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("promo_banners")
}

// ============================================================
// COURIERS & TRACKING
// ============================================================

model Courier {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @db.Uuid
  vehicle     String?
  plate       String?
  currentLat  Float?
  currentLon  Float?
  lastPingAt  DateTime?
  isAvailable Boolean   @default(true)
  createdAt   DateTime  @default(now())

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments CourierAssignment[]
  logs        CourierLocationLog[]

  @@map("couriers")
}

model CourierLocationLog {
  id        String   @id @default(uuid()) @db.Uuid
  courierId String   @db.Uuid
  userId    String   @db.Uuid
  latitude  Float
  longitude Float
  heading   Float?
  speedKmh  Float?
  createdAt DateTime @default(now())

  courier Courier @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@index([courierId, createdAt])
  @@map("courier_location_logs")
}

model CourierAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  orderId     String    @unique @db.Uuid
  courierId   String    @db.Uuid
  assignedAt  DateTime  @default(now())
  deliveredAt DateTime?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier Courier @relation(fields: [courierId], references: [id])

  @@index([courierId])
  @@map("courier_assignments")
}